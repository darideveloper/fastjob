SECRET_KEY=your-secret-key-here
DEBUG=True
# ALLOWED_HOSTS / SITE_DOMAIN / CSRF_TRUSTED_ORIGINS:
#   For local dev, the defaults below work as-is.
#   For Coolify/production with one domain, you can leave these unset — compose
#   will derive them from SERVICE_FQDN_WEB.
#   For multi-domain prod (e.g. vanity domain + Coolify subdomain), set all three
#   in the Coolify UI as project-level env vars with Runtime enabled.
ALLOWED_HOSTS=localhost,127.0.0.1,fastjob.localhost

# Database
DATABASE_URL=postgres://user:password@localhost:5432/fastjob

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4
GUNICORN_TIMEOUT=300

# Storage (AWS/S3 Compatible)
STORAGE_AWS=True
AWS_ACCESS_KEY_ID=your-spaces-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_PROJECT_FOLDER=fastjob-prod
AWS_S3_REGION_NAME=nyc3
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=your-bucket.nyc3.cdn.digitaloceanspaces.com

# Google OAuth2 (Gmail Modify scope)
# Credentials are now managed via Django Admin (SocialApp model).
GOOGLE_OAUTH_PROJECT_MODE=production

# Microsoft OAuth2 (Mail.Send scope)
# Credentials are now managed via Django Admin (SocialApp model).
MICROSOFT_TENANT=common

# Stripe (EUR)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site
SITE_DOMAIN=fastjob.localhost:8000
SITE_SCHEME=https
SITE_NAME=FastJob

# Email (for system notifications like re-link alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=system@yourdomain.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FastJob <system@yourdomain.com>

# Cache (reuses Redis; separate db from Celery to avoid collisions)
CACHE_REDIS_URL=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO

# Sentry — leave SENTRY_DSN empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Production security — flip ALL of these to True once behind HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=True
CSRF_TRUSTED_ORIGINS=http://fastjob.localhost:8000,https://fastjob.localhost

# Rate limiting
RATELIMIT_ENABLE=True
# Number of reverse-proxy hops you control. 1 for Coolify/Traefik; this is
# what lets per-IP throttling identify the real visitor instead of the proxy.
# Raise to 2 if you place a CDN in front of Traefik.
TRUSTED_PROXY_HOPS=1
# Per-real-IP throttles for the public company-filter API (filter-options /
# count). Defaults are generous enough for normal browsing behind shared NAT.
RATELIMIT_FILTER_OPTIONS=300/h
RATELIMIT_FILTER_COUNT=600/h

# Flower (Celery task monitor) — format: "user:password". Never expose publicly.
FLOWER_BASIC_AUTH=admin:changeme
