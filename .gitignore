# =============================================================================
# Secrets & sensitive data — NEVER commit
# =============================================================================
# Local environment files. .env.example IS committed (template only).
.env
.env.*
!.env.example

# Cloud / service credentials that occasionally land in repos by accident.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
credentials.json
service-account*.json
gcp-key*.json
aws-credentials*
.boto
.aws/
.gcp/

# OAuth / Stripe / DigitalOcean ad-hoc files (CLI dumps, exports, etc.)
.stripe/
client_secret*.json

# Local SSH / SSL keys
id_rsa
id_dsa
id_ed25519
*.ppk
known_hosts

# =============================================================================
# User data (PII) — written to disk when Spaces isn't configured
# =============================================================================
# Django's FileField(upload_to="cvs/") drops PDFs here in local-only setups.
# These are CV files containing real personal information — never commit.
cvs/
media/
# Company-import .xlsx staging dir (COMPANY_IMPORT_LOCAL_PATH default).
# Operator-uploaded files land here in local-only setups; never commit.
imports/

# Database dumps produced by scripts/backup_db.sh or manual pg_dump.
*.sql
*.sql.gz
*.dump
*.bak
backup_*
resumelink-*.sql.gz

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtualenvs
.venv/
venv/
env/
ENV/
.python-version
.envrc

# =============================================================================
# Django
# =============================================================================
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite

# Collected static (regenerated by `manage.py collectstatic`)
staticfiles/
/static_collected/

# Django migrations are committed by convention. Do NOT add migrations/ here.

# =============================================================================
# Celery
# =============================================================================
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
celery.pid
flower.db

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
sentry-debug.log
gunicorn-*.log
resumelink-backup.log

# =============================================================================
# Test / coverage / type-checker artifacts
# =============================================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/
nosetests.xml
test-results/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pyright/

# =============================================================================
# Notebooks
# =============================================================================
.ipynb_checkpoints/

# =============================================================================
# Frontend (in case Tailwind/PostCSS is added later)
# =============================================================================
node_modules/
.npm/
.yarn/
.pnp.*
package-lock.json.bak
yarn-error.log
.parcel-cache/

# =============================================================================
# Docker
# =============================================================================
# docker-compose.override.yml is the conventional name for local-only overrides.
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# =============================================================================
# IDEs & editors
# =============================================================================
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.history/

# =============================================================================
# OS-level cruft
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Trashes
.Spotlight-V100

# =============================================================================
# Claude Code / AI assistant local files
# =============================================================================
# Per-machine settings, transcripts, memory — not for the repo.
.claude/
.chat.txt
.aider*
.cursorrules
.continue/
# Other agent runtimes / project-level instruction files. These are local
# tooling state, not source of truth — keep them out of the repo. The
# leading `/` anchors to the repo root so we don't accidentally ignore
# nested AGENTS.md / CLAUDE.md files (e.g. `openspec/AGENTS.md`, which
# IS part of the OpenSpec scaffolding and should stay tracked).
.gemini/
/AGENTS.md
/CLAUDE.md

# =============================================================================
# OpenSpec
# =============================================================================
# In-flight proposals under openspec/changes/ are working drafts. They land
# in the repo only once moved to changes/archive/. Convention from
# openspec-ignoring-proposals.md.
openspec/changes/*
!openspec/changes/archive/

# =============================================================================
# Misc
# =============================================================================
*.tmp
*.temp
*.orig
*.rej
*.pid
*.seed
*.tar
*.tar.gz
*.zip
.scratch/
TODO.local.md
NOTES.local.md
data/

.playwright-cli/

.agents/
skills-lock.json
.antigravitycli/

# .gitignore
# Ignore proposals
openspec/changes/*

# Do not ignore archived proposals
!openspec/changes/archive/

# skip docs
docs/

# ignore by default all hiden folders (like agents folders)
.*/
